        { no: 50, cat: '医療倫理', text: 'SOAPで正しいのはどれか。', opts: ['Sには患者の評価結果を記載する。', 'Oには患者の訴えを記載する。', 'Aには治療プログラムを記載する。', 'Pには評価結果の解釈を記載する。', '問題指向型の診療記録である。'], ans: 4 }
    ];

    addQuestions(sheet, questions, '58-AM');
}

function addQuestions(sheet, questions, prefix) {
    var addedCount = 0;
    var data = sheet.getDataRange().getValues();

    questions.forEach(function (q) {
        var id = prefix + '-' + String(q.no).padStart(2, '0');
        var exists = data.some(function (row) { return row[0] === id; });

        if (exists) {
            Logger.log('スキップ（既存）: ' + id);
            return;
        }

        var correctIdx = String(q.ans).includes(',') ? q.ans : (parseInt(q.ans));

        var row = [
            id, 58, '午前', q.no, q.cat, q.text,
            JSON.stringify(q.opts), correctIdx, '（解説準備中）', '', 3, new Date(), 'text_only'
        ];

        sheet.appendRow(row);
        addedCount++;
        Logger.log('追加完了: ' + id);
    });

    Logger.log('追加数: ' + addedCount);
}
