        { no: 50, cat: '地域', text: '三次予防にあたるのはどれか。', opts: ['高血圧患者の薬物療法', '高齢者の骨折予防指導', '乳癌のマンモグラフィ検診', '脳卒中患者の職場復帰支援', 'インフルエンザワクチンの接種'], ans: 4 }
    ];

    addQuestions(sheet, questions, '60-AM');
}

function addQuestions(sheet, questions, prefix) {
    var addedCount = 0;
    var data = sheet.getDataRange().getValues();

    questions.forEach(function (q) {
        var id = prefix + '-' + String(q.no).padStart(3, '0');
        var exists = data.some(function (row) { return row[0] === id; });

        if (exists) {
            Logger.log('スキップ（既存）: ' + id);
            return;
        }

        var correctIdx = String(q.ans).includes(',') ? q.ans : (parseInt(q.ans) - 1);

        var row = [
            id, 60, '午前', String(q.no).padStart(3, '0'), q.cat, q.text,
            JSON.stringify(q.opts), correctIdx, '（解説準備中）', '', 3, new Date(), 'text_only'
        ];

        sheet.appendRow(row);
        addedCount++;
        Logger.log('追加完了: ' + id);
    });

    Logger.log('追加数: ' + addedCount);
}
